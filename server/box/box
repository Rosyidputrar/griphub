#!/usr/bin/env bash
# GripHub box: runs commands inside a rootless Podman container, so the agent can `apt-get install` anything it
# needs without any power over the server itself. Adapted from CoderRa's server mode (seseegy/coderra server/box/box).
#
#   box -c 'apt-get install -y python3 && python3 x.py'   run one command (this is how the host's bash tool calls it)
#   box                                                    a login shell in the container
#   box --reset                                            throw the container away; the next call makes a new one
#
# The host points its bash tool at this script (settings.json shellPath), so every command the agent runs lands here.
#
# What the container sees:
#   - the workspace, at the same path as outside (read-write), so files are shared both ways;
#   - its own home folder at the same path as the real home (~/.griphub/box-home, kept between runs), with copies of
#     the git and ssh settings the app configured. authorized_keys is never copied: it would let a command in the box
#     plant access to the server.
# Memory and CPU are capped (BOX_MEMORY, BOX_SWAP, BOX_CPUS in the environment or in ~/.griphub/box.conf).
#
# The container shares the server's network (--network=host) so a dev server started in it is reachable on
# localhost:<port> for the app's tunnel. That also means it can reach everything the server can: use this on a
# machine that runs nothing else you care about.
set -eu

HOME_DIR=${HOME:?box: HOME is not set}
GRIPHUB_DIR=${GRIPHUB_DIR:-$HOME_DIR/.griphub}
NAME=${GRIPHUB_BOX_NAME:-griphub-box}
IMAGE=${GRIPHUB_BOX_IMAGE:-localhost/griphub-box}
WS=${GRIPHUB_WORKSPACE:-$HOME_DIR/workspace}
BOXHOME=${GRIPHUB_BOX_HOME:-$GRIPHUB_DIR/box-home}
CONF=${GRIPHUB_BOX_CONF:-$GRIPHUB_DIR/box.conf}
# shellcheck disable=SC1090
[ -f "$CONF" ] && . "$CONF"
MEMORY=${BOX_MEMORY:-2g}
SWAP=${BOX_SWAP:-3g}
CPUS=${BOX_CPUS:-1.5}

if [ "${1:-}" = "--reset" ]; then
	podman rm -f "$NAME" >/dev/null 2>&1 || true
	exit 0
fi

state() {
	podman container inspect --format '{{.State.Status}}' "$NAME" 2>/dev/null || true
}

# Starts podman for a container that outlives this call. conmon, the process podman leaves behind to watch the container,
# stays in the cgroup of whoever started it. When that is griphub-hostd.service, restarting the host (every app update
# does) stops conmon, and conmon takes the container and everything running in it down. A scope of its own keeps the
# box apart from the host. Without a user session bus there is no scope to make, and podman runs as it always did.
detached() {
	if command -v systemd-run >/dev/null 2>&1 && [ -S "${XDG_RUNTIME_DIR:-/nonexistent}/bus" ]; then
		systemd-run --user --scope --quiet --collect --description="GripHub box" -- "$@"
	else
		"$@"
	fi
}

create() {
	if ! podman image exists "$IMAGE"; then
		# The agent reads this (it is the output of its command) and passes it on, so it says what the user can do.
		echo "box: the agent's box (the container its commands run in) has not been built on this server yet, so no" >&2
		echo "     command can run. Build it in the app: Settings > The agent's box > Build the box. Or on the server:" >&2
		echo "     podman build -t $IMAGE -f ~/.griphub/box/Containerfile ~/.griphub/box" >&2
		exit 127
	fi
	detached podman run -d --name "$NAME" --hostname "$NAME" --init --network=host \
		--memory "$MEMORY" --memory-swap "$SWAP" --cpus "$CPUS" \
		-v "$BOXHOME:$HOME_DIR" -v "$WS:$WS" -e "HOME=$HOME_DIR" -w "$WS" \
		"$IMAGE" sleep infinity >/dev/null 9>&-
}

# Two calls arriving together on first use must not both try to create the container.
ensure_running() {
	mkdir -p "$GRIPHUB_DIR" "$WS"
	( umask 077; mkdir -p "$BOXHOME" )
	exec 9>"$GRIPHUB_DIR/box.lock"
	flock -w 60 9 || { echo "box: another box operation is still running; try again in a minute" >&2; exit 75; }
	case "$(state)" in
		running) ;;
		"") create ;;
		*) detached podman start "$NAME" >/dev/null 9>&- ;;
	esac
	exec 9>&-
}

# The app keeps the git and ssh settings in the server's real home; the container's home is a separate folder, so
# copy what it needs. Files are replaced each time (git rewrites its config by renaming, which a single-file bind mount
# would not follow); known_hosts is left alone once the container has its own, so hosts it learns are not lost.
sync_settings() {
	( umask 077
	mkdir -p "$BOXHOME/.ssh"
	for f in .gitconfig .ssh/config .ssh/id_ed25519 .ssh/id_ed25519.pub; do
		if [ -f "$HOME_DIR/$f" ]; then
			cp -f "$HOME_DIR/$f" "$BOXHOME/$f.tmp" && mv -f "$BOXHOME/$f.tmp" "$BOXHOME/$f"
		else
			rm -f "$BOXHOME/$f"
		fi
	done
	if [ -f "$HOME_DIR/.ssh/known_hosts" ] && [ ! -f "$BOXHOME/.ssh/known_hosts" ]; then
		cp "$HOME_DIR/.ssh/known_hosts" "$BOXHOME/.ssh/known_hosts"
	fi )
}

ensure_running
sync_settings

# Run where the caller is when that is inside the workspace; anywhere else the container has nothing to show.
cwd=$WS
case "${PWD:-}" in
	"$WS" | "$WS"/*) cwd=$PWD ;;
	"$HOME_DIR") cwd=$HOME_DIR ;;
esac

flags=(-i)
if [ -t 0 ] && [ -t 1 ]; then
	flags+=(-t)
else
	flags+=(-e GIT_TERMINAL_PROMPT=0)
fi
flags+=(-e "TERM=${TERM:-xterm-256color}" -e LANG=C.UTF-8 -e DEBIAN_FRONTEND=noninteractive -e "HOME=$HOME_DIR")
# By name only: podman takes the value from this environment, so the tokens never show up in a process listing.
for v in GITHUB_TOKEN GH_TOKEN VERCEL_TOKEN CLOUDFLARE_API_TOKEN CLOUDFLARE_ACCOUNT_ID; do
	[ -n "${!v:-}" ] && flags+=(-e "$v")
done

[ "$#" -eq 0 ] && set -- -l
exec podman exec "${flags[@]}" -w "$cwd" "$NAME" /bin/bash "$@"
