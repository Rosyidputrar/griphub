#!/usr/bin/env bash
# GripHub box: runs commands inside a rootless Podman container, so the agent can `apt-get install` anything it
# needs without any power over the server itself. Adapted from CoderRa's server mode (seseegy/coderra server/box/box).
#
#   box -c 'apt-get install -y python3 && python3 x.py'   run one command (this is how the host's bash tool calls it)
#   box                                                    a login shell in the container
#   box --reset                                            throw the container away; the next call makes a new one
#
# The host points its bash tool at this script (settings.json shellPath), so every command the agent runs lands here.
#
# What the container sees:
#   - the workspace, at the same path as outside (read-write), so files are shared both ways;
#   - its own home folder at the same path as the real home (~/.griphub/box-home, kept between runs), with copies of
#     the git and ssh settings the app configured. authorized_keys is never copied: it would let a command in the box
#     plant access to the server. The copies go in through `podman exec` and the host never writes into that folder
#     itself: a command in the box can put links there, and a host that follows them writes the server's own files.
# Memory and CPU are capped (BOX_MEMORY, BOX_SWAP, BOX_CPUS in the environment or in ~/.griphub/box.conf).
#
# The container shares the server's network (--network=host) so a dev server started in it is reachable on
# localhost:<port> for the app's tunnel. That also means it can reach everything the server can: use this on a
# machine that runs nothing else you care about.
set -eu

HOME_DIR=${HOME:?box: HOME is not set}
GRIPHUB_DIR=${GRIPHUB_DIR:-$HOME_DIR/.griphub}
NAME=${GRIPHUB_BOX_NAME:-griphub-box}
IMAGE=${GRIPHUB_BOX_IMAGE:-localhost/griphub-box}
WS=${GRIPHUB_WORKSPACE:-$HOME_DIR/workspace}
BOXHOME=${GRIPHUB_BOX_HOME:-$GRIPHUB_DIR/box-home}
CONF=${GRIPHUB_BOX_CONF:-$GRIPHUB_DIR/box.conf}
# shellcheck disable=SC1090
[ -f "$CONF" ] && . "$CONF"
MEMORY=${BOX_MEMORY:-2g}
SWAP=${BOX_SWAP:-3g}
CPUS=${BOX_CPUS:-1.5}
# How long podman may take before the box is called stuck. A container can show "Running" while every `podman exec`
# hangs; every command the agent ran then hung with it, for as long as the tool's own time limit, saying nothing. Each
# call into podman that comes before the command is bounded, and the exec path is probed before the command goes in.
PROBE_SECS=${BOX_PROBE_SECS:-30}
START_SECS=${BOX_START_SECS:-120}
# How long an answer to the probe counts, so a burst of commands does not probe each time.
ALIVE_SECS=${BOX_ALIVE_SECS:-30}
ALIVE="$GRIPHUB_DIR/box.alive"
# When the git and ssh settings were last put in the box, and what they looked like then.
SYNCED="$GRIPHUB_DIR/box.synced"

if [ "${1:-}" = "--reset" ]; then
	podman rm -f "$NAME" >/dev/null 2>&1 || true
	rm -f "$ALIVE" "$SYNCED"
	exit 0
fi

# timeout(1) says 124 when it stopped a command, or 137 when it had to kill it.
timed_out() {
	[ "$1" -eq 124 ] || [ "$1" -eq 137 ]
}

# The agent reads this (it is the output of its command) and passes it on. The command is refused, never run outside the
# box: the box is what keeps the agent's commands off the rest of the server, and that is not given up unasked.
stuck() {
	echo "box: the agent's box did not answer ($1), so its container may be stuck. The command was not run." >&2
	echo "     In the app: Settings > The agent's box > Reset the box. Or turn off \"Run the agent's commands in the box\"" >&2
	echo "     to run commands on the server itself. On the server: box --reset" >&2
	exit 70
}

# The container's status, or nothing when there is none. Returns 124 when podman did not answer.
state() {
	local rc=0
	timeout -k 5 "$PROBE_SECS" podman container inspect --format '{{.State.Status}}' "$NAME" 2>/dev/null || rc=$?
	if timed_out "$rc"; then return 124; fi
	return 0
}

# Starts podman for a container that outlives this call. conmon, the process podman leaves behind to watch the container,
# stays in the cgroup of whoever started it. When that is griphub-hostd.service, restarting the host (every app update
# does) stops conmon, and conmon takes the container and everything running in it down. A scope of its own keeps the
# box apart from the host. Without a user session bus there is no scope to make, and podman runs as it always did.
detached() {
	if command -v systemd-run >/dev/null 2>&1 && [ -S "${XDG_RUNTIME_DIR:-/nonexistent}/bus" ]; then
		systemd-run --user --scope --quiet --collect --description="GripHub box" -- "$@"
	else
		"$@"
	fi
}

create() {
	local rc=0
	timeout -k 5 "$PROBE_SECS" podman image exists "$IMAGE" || rc=$?
	if timed_out "$rc"; then stuck "podman did not answer in ${PROBE_SECS}s"; fi
	if [ "$rc" -ne 0 ]; then
		# The agent reads this (it is the output of its command) and passes it on, so it says what the user can do.
		echo "box: the agent's box (the container its commands run in) has not been built on this server yet, so no" >&2
		echo "     command can run. Build it in the app: Settings > The agent's box > Build the box. Or on the server:" >&2
		echo "     podman build -t $IMAGE -f ~/.griphub/box/Containerfile ~/.griphub/box" >&2
		exit 127
	fi
	rc=0
	detached timeout -k 5 "$START_SECS" podman run -d --name "$NAME" --hostname "$NAME" --init --network=host \
		--memory "$MEMORY" --memory-swap "$SWAP" --cpus "$CPUS" \
		-v "$BOXHOME:$HOME_DIR" -v "$WS:$WS" -e "HOME=$HOME_DIR" -w "$WS" \
		"$IMAGE" sleep infinity >/dev/null 9>&- || rc=$?
	if timed_out "$rc"; then stuck "making the container took more than ${START_SECS}s"; fi
	[ "$rc" -eq 0 ] || exit "$rc"
}

start_box() {
	local rc=0
	detached timeout -k 5 "$START_SECS" podman start "$NAME" >/dev/null 9>&- || rc=$?
	if timed_out "$rc"; then stuck "starting the container took more than ${START_SECS}s"; fi
	[ "$rc" -eq 0 ] || exit "$rc"
}

# Two calls arriving together on first use must not both try to create the container.
ensure_running() {
	mkdir -p "$GRIPHUB_DIR" "$WS"
	( umask 077; mkdir -p "$BOXHOME" )
	exec 9>"$GRIPHUB_DIR/box.lock"
	flock -w 60 9 || { echo "box: another box operation is still running; try again in a minute" >&2; exit 75; }
	local status rc=0
	status=$(state) || rc=$?
	if timed_out "$rc"; then stuck "podman did not answer in ${PROBE_SECS}s"; fi
	case "$status" in
		running) ;;
		"") rm -f "$ALIVE" "$SYNCED"; create ;;
		*) rm -f "$ALIVE" "$SYNCED"; start_box ;;
	esac
	exec 9>&-
}

# Proves that `podman exec` answers before the agent's command goes in: "Running" says nothing about that. It is not
# repeated for ALIVE_SECS after it answered. Only a probe that timed out refuses the command; one that failed some other
# way is left to the command itself, which then fails with podman's own message.
probe() {
	local at now rc=0
	if at=$(stat -c %Y "$ALIVE" 2>/dev/null) && now=$(date +%s) && [ $((now - at)) -lt "$ALIVE_SECS" ]; then return 0; fi
	timeout -k 5 "$PROBE_SECS" podman exec "$NAME" true >/dev/null 2>&1 || rc=$?
	if timed_out "$rc"; then stuck "a command in it did not start in ${PROBE_SECS}s"; fi
	if [ "$rc" -eq 0 ]; then ( umask 077; : > "$ALIVE" ); fi
	return 0
}

# The git and ssh settings the app keeps in the server's real home, and the container's home is a separate folder, so
# what it needs is copied in. Files are replaced (git rewrites its config by renaming, which a single-file bind mount
# would not follow); known_hosts is only put in when the container has none, so hosts it learns are not lost.
#
# The host never writes into the container's home (BOXHOME) itself. Any command in the box can change that folder: it
# used to be copied into from here, and `ln -s ~/.ssh/authorized_keys ~/.gitconfig.tmp` (or `.ssh` made a link) sent
# those copies over the server's own files, the phone's key and the store key among them; a fresh link made while the
# copy ran got past any check made before it. The files are sent through `podman exec` instead and installed by a
# script that runs in the container, where an absolute link leads only to what the container itself holds.
SYNC_FILES=(.gitconfig .ssh/config .ssh/id_ed25519 .ssh/id_ed25519.pub)

# What runs in the container: reads "put|del|seed <name> <base64>" lines. Only the names above are accepted. Each file
# is written beside its place and moved onto it, which replaces what is there (a link included) and follows nothing.
# shellcheck disable=SC2016 # the container's shell expands these, not this one
INSTALL='umask 077
cd "$HOME" || exit 1
mkdir -p .ssh && chmod 700 .ssh || exit 1
while read -r mode name data; do
	case "$name" in
		.gitconfig | .ssh/config | .ssh/id_ed25519 | .ssh/id_ed25519.pub | .ssh/known_hosts) ;;
		*) exit 2 ;;
	esac
	case "$mode" in
		del) rm -f "$name" ;;
		put) rm -f "$name.new" && printf %s "$data" | base64 -d > "$name.new" && mv -fT "$name.new" "$name" ;;
		seed) [ -e "$name" ] || [ -L "$name" ] || { rm -f "$name.new" && printf %s "$data" | base64 -d > "$name.new" && mv -fT "$name.new" "$name"; } ;;
		*) exit 2 ;;
	esac || exit 3
done'

# The files as the lines above, or nothing and a failure when one that exists cannot be read: a key that could not be
# read must not be put in as an empty file.
settings_payload() {
	local f data
	for f in "${SYNC_FILES[@]}"; do
		if [ -f "$HOME_DIR/$f" ]; then
			data=$(base64 -w0 "$HOME_DIR/$f") || return 1
			printf 'put %s %s\n' "$f" "$data"
		else
			printf 'del %s\n' "$f"
		fi
	done
	if [ -f "$HOME_DIR/.ssh/known_hosts" ]; then
		data=$(base64 -w0 "$HOME_DIR/.ssh/known_hosts") || return 1
		printf 'seed %s %s\n' .ssh/known_hosts "$data"
	fi
}

# What the files look like now (names, sizes and times), so a change is seen without reading them.
settings_fingerprint() {
	local f
	for f in "${SYNC_FILES[@]}" .ssh/known_hosts; do
		stat -c '%n %s %Y' "$HOME_DIR/$f" 2>/dev/null || echo "$f -"
	done | cksum
}

# Puts the settings in the box when they changed since the last time, and again after ALIVE_SECS, so what a command in
# the box did to them does not last. A failure other than a timeout is said and the command goes on: they are
# conveniences (git's identity, an ssh key), not what the command needs to run.
sync_settings() {
	local fp at now payload rc=0
	fp=$(settings_fingerprint)
	if [ "$(cat "$SYNCED" 2>/dev/null)" = "$fp" ] && at=$(stat -c %Y "$SYNCED" 2>/dev/null) && now=$(date +%s) && [ $((now - at)) -lt "$ALIVE_SECS" ]; then
		return 0
	fi
	payload=$(settings_payload) || { echo "box: could not read the git and ssh settings to put in the box; the command runs without them" >&2; return 0; }
	printf '%s\n' "$payload" | timeout -k 5 "$PROBE_SECS" podman exec -i -e "HOME=$HOME_DIR" "$NAME" /bin/sh -c "$INSTALL" || rc=$?
	if timed_out "$rc"; then stuck "putting its git and ssh settings in took more than ${PROBE_SECS}s"; fi
	if [ "$rc" -ne 0 ]; then echo "box: could not put the git and ssh settings in the box (exit code $rc); the command runs without them" >&2; fi
	( umask 077; printf '%s\n' "$fp" > "$SYNCED" )
}

ensure_running
probe
sync_settings

# Run where the caller is when that is inside the workspace; anywhere else the container has nothing to show.
cwd=$WS
case "${PWD:-}" in
	"$WS" | "$WS"/*) cwd=$PWD ;;
	"$HOME_DIR") cwd=$HOME_DIR ;;
esac

flags=(-i)
if [ -t 0 ] && [ -t 1 ]; then
	flags+=(-t)
else
	flags+=(-e GIT_TERMINAL_PROMPT=0)
fi
flags+=(-e "TERM=${TERM:-xterm-256color}" -e LANG=C.UTF-8 -e DEBIAN_FRONTEND=noninteractive -e "HOME=$HOME_DIR")
# By name only: podman takes the value from this environment, so the tokens never show up in a process listing.
for v in GITHUB_TOKEN GH_TOKEN VERCEL_TOKEN CLOUDFLARE_API_TOKEN CLOUDFLARE_ACCOUNT_ID; do
	[ -n "${!v:-}" ] && flags+=(-e "$v")
done

[ "$#" -eq 0 ] && set -- -l
exec podman exec "${flags[@]}" -w "$cwd" "$NAME" /bin/bash "$@"
